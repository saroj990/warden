# Copy to .env and adjust. Never commit real secrets.

# Ollama (local default)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# OpenAI-compatible provider (optional; used only when selected)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# GitHub pull request reviews (warden github review). Never printed.
# Leave empty for local-only use. GITHUB_API_URL defaults to the public API.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# Bitbucket (later; leave empty for local-only use)
BITBUCKET_TOKEN=
